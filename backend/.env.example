# Server
PORT=4000
NODE_ENV=development

# Database
DATABASE_URL=postgres://vortex:vortex@localhost:5432/vortex_dialer

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Telephony
TELEPHONY_PROVIDER=mock

# Twilio (phase 2 — unused while TELEPHONY_PROVIDER=mock)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Frontend origin allowed to call this API
CORS_ORIGIN=http://localhost:5173
