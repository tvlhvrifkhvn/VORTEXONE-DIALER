# Server
PORT=4000
NODE_ENV=development

# Database
DATABASE_URL=postgres://vortex:vortex@localhost:5432/vortex_dialer

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Telephony
TELEPHONY_PROVIDER=mock
SMS_PROVIDER=mock
EMAIL_PROVIDER=mock

# Twilio (phase 2 — unused while TELEPHONY_PROVIDER=mock)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Stale-lock sweep (see services/leadQueue.js releaseStaleLocks). A lead locked
# with no live call is returned to in_queue 30 s after its lock/hangup; the
# server checks every 10 s. Set STALE_LOCK_SWEEP=off to rely on queue reads only.
# STALE_LOCK_SWEEP=on
# A call still open after this many minutes is treated as dangling: its lead is
# released and the call row closed. Default 240.
# MAX_LIVE_CALL_MINUTES=240

# Frontend origin allowed to call this API
CORS_ORIGIN=http://localhost:5173

# Seed user (npm run seed). There is no default password: if SEED_USER_PASSWORD
# is unset, the seed generates a random one and prints it ONCE. An existing
# seed user is never modified.
# SEED_USER_EMAIL=
# SEED_USER_PASSWORD=
# SEED_USER_NAME=

# Groq (AI CSV column mapping + note expansion — see services/aiCsvMapper.js
# and services/noteExpander.js). Leave blank to disable those features.
GROQ_API_KEY=
# Optional: override the Groq API host (leave unset). Used to test the pre-call
# brief's 3s timeout against a deliberately slow local stub.
# GROQ_BASE_URL=
